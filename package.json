{
  "name": "agromax-editorial-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview --host 0.0.0.0",
    "check": "tsx scripts/check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/auth src/phase2 src/pages src/layout src/App.tsx scripts/prerender.tsx src/components/Film.tsx"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "gsap": "^3.14.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.187.0",
    "eslint": "10.14.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.2.0"
  }
}
