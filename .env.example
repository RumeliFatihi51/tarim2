# Local development settings. Do not commit a real .env file.
NODE_ENV="development"
PORT="3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Keep this true only on a private local machine. Production always requires JWT authentication.
ALLOW_INSECURE_LOCAL_AUTH="true"
# Local append-only archive for completed analyses and MRV reports.
ANALYSIS_STORAGE_DIR="./data/analyses"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required in production (at least 32 characters). Issue tokens with sub, companyId and role claims.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# A PostgreSQL URL is recommended for multi-instance production deployments.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/terrasat"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
